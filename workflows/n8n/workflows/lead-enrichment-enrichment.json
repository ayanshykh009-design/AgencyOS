            },
            {
              "id": "a2000000-0000-4000-8000-000000000007",
              "name": "company",
              "value": "={{ $json.person && $json.person.organization ? ($json.person.organization.name || $('Inbound Prospect Webhook').item.json.body.company) : $('Inbound Prospect Webhook').item.json.body.company }}",
              "type": "string"
            },
            {
              "id": "a2000000-0000-4000-8000-000000000008",
