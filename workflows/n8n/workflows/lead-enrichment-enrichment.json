              "type": "string"
            },
            {
              "id": "a2000000-0000-4000-8000-00000000000a",
              "name": "website",
              "value": "={{ $json.person ? ($json.person.website_url || $('Inbound Prospect Webhook').item.json.body.website) : $('Inbound Prospect Webhook').item.json.body.website }}",
              "type": "string"
            },
            {
              "id": "a2000000-0000-4000-8000-00000000000b",
              "name": "phone",
              "value": "={{ $json.person ? ($json.person.phone || $('Inbound Prospect Webhook').item.json.body.phone) : $('Inbound Prospect Webhook').item.json.body.phone }}",
              "type": "string"
            }
          ]
        },
        "options": {}
