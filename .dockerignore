# Build context = repo root. Keep it small and secret-free.
.git
.github
.gitignore
**/node_modules
**/__pycache__
**/*.pyc
**/.venv
**/.next
**/.pytest_cache
**/.ruff_cache

.env
.env.*
!.env.example

storage/*
!storage/.gitkeep

docs/
tests/
workflows/
database/
prompts/
scripts/
Makefile
README.md
*.log
