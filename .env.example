# ------------------------------------------------------------------
# AgencyOS — environment template (root)
# Copy to .env and fill in real values. NEVER commit .env.
# For production, use: cp .env.example .env.production
# Sub-folders carry their own focused .env.example files:
#   - backend/.env.example
#   - frontend/.env.example
# ------------------------------------------------------------------

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
APP_TIMEZONE=UTC
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# --- Local Postgres (dev mirror of the Supabase schema) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=agencyos
POSTGRES_USER=agencyos
POSTGRES_PASSWORD=change-me

# --- Supabase (managed PostgreSQL) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Backend (FastAPI) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ISSUER=agencyos
JWT_AUDIENCE=agencyos-api
BACKEND_PORT=8000
# Comma-separated origins allowed to call this API
CORS_ORIGINS=http://localhost:3000
# Comma-separated allowed Host headers
TRUSTED_HOSTS=localhost,127.0.0.1

# --- Database pool (backend) ---
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# --- Redis (optional; shared rate limiting / cache across instances) ---
REDIS_URL=

# --- Logging ---
LOG_LEVEL=INFO
LOG_TO_FILE=false

# --- Rate limiting (slowapi; Redis required for multi-instance) ---
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_STRICT=20/minute

# --- Observability (OpenTelemetry; enable in staging/production) ---
OTEL_ENABLED=false
OTEL_SERVICE_NAME=agencyos-api
OTEL_ENDPOINT=

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_ENV=development

# --- n8n automation ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
N8N_ENCRYPTION_KEY=replace-with-a-random-32-byte-key
# Pin to an audited release before deploying (matches docker compose default)
N8N_IMAGE_TAG=2.32.7

# --- AI providers (used by the prompts layer & backend integrations) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Email / SMTP (outreach delivery) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- LinkedIn (via n8n / API) ---
LINKEDIN_API_ACCESS_TOKEN=
