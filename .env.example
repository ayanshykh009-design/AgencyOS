# ------------------------------------------------------------------
# AgencyOS — environment template (root)
# Copy to .env and fill in real values. NEVER commit .env.
# Sub-folders carry their own focused .env.example files:
#   - backend/.env.example
#   - frontend/.env.example
# ------------------------------------------------------------------

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=UTC
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# --- Local Postgres (dev mirror of the Supabase schema) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=agencyos
POSTGRES_USER=agencyos
POSTGRES_PASSWORD=change-me

# --- Supabase (managed PostgreSQL) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Backend (FastAPI) ---
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_PORT=8000
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- n8n automation ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
N8N_ENCRYPTION_KEY=replace-with-a-random-32-byte-key

# --- AI providers (used by the prompts layer & backend integrations) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Email / SMTP (outreach delivery) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- LinkedIn (via n8n / API) ---
LINKEDIN_API_ACCESS_TOKEN=
