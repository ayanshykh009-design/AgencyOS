# AgencyOS frontend — environment template
# Copy to .env.local for local development (NEVER commit .env.local).
# Only NEXT_PUBLIC_* variables are exposed to the browser bundle.

# Backend API base URL (FastAPI, mounted under /api/v1).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Runtime environment label (development | staging | production).
NEXT_PUBLIC_APP_ENV=development

# Supabase (managed PostgreSQL + Auth). Only public/anon values are safe here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
