{
  "name": "agencyos-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "AgencyOS — Next.js frontend (AI Outreach Agency Operating System)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
