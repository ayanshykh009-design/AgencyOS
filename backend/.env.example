# AgencyOS backend — environment template
# Copy to .env (inside backend/) and fill in real values.
# Root-level .env (docker-compose) and this file are separate; when running
# uvicorn from backend/, app/core/config.py loads this file.

# --- App ---
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# --- Security ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ISSUER=agencyos
JWT_AUDIENCE=agencyos-api
# Shared secret for inbound webhooks (n8n / contact forms); required in prod.
WEBHOOK_SECRET=

# --- Database ---
# Local dev database (must match docker-compose postgres service)
DATABASE_URL=postgresql+asyncpg://agencyos:change-me@localhost:5432/agencyos
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# --- Supabase (managed PostgreSQL) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Redis (optional; shared rate limiting / cache across instances) ---
REDIS_URL=

# --- HTTP hardening ---
# Comma-separated origins allowed to call this API
CORS_ORIGINS=http://localhost:3000
# Comma-separated allowed Host headers
TRUSTED_HOSTS=localhost,127.0.0.1
SECURITY_HEADERS=true
# Content-Security-Policy: restrictive by default (on). Keep enabled in prod.
ENABLE_CSP=true
# Comma-separated extra connect-src origins (e.g. Supabase, n8n, LLM gateway)
CSP_CONNECT_ORIGINS=

# --- Logging ---
LOG_LEVEL=INFO
# Set true to also write logs to the rotating file under storage/logs/
LOG_TO_FILE=false
LOG_FILE_PATH=../storage/logs/backend.log

# --- Rate limiting (slowapi; Redis required for multi-instance) ---
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_STRICT=20/minute
# AI endpoints trigger LLM/n8n work — keep tighter than the default.
RATE_LIMIT_AI=60/minute

# --- CSV import worker ---
IMPORT_WORKER_ENABLED=true
IMPORT_CHUNK_SIZE=200
UPLOAD_DIR=../storage/uploads

# --- Observability (OpenTelemetry; enable in staging/production) ---
OTEL_ENABLED=false
OTEL_SERVICE_NAME=agencyos-api
OTEL_ENDPOINT=

# --- LLM provider layer (app/llm) ---
# Select the provider and default model used by LLMService. Secrets come from
# below; never commit real keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=openai          # openai | anthropic | gemini | openai-compatible | ollama | deepseek
LLM_DEFAULT_MODEL=gpt-4o-mini
LLM_BASE_URL=                # override for openai-compatible / ollama / deepseek
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=4096
LLM_DEFAULT_TEMPERATURE=0.7
LLM_MAX_RETRIES=3                 # transient provider failures (rate limit / 5xx)
LLM_RETRY_MIN_BACKOFF=1.0         # seconds; exponential backoff floor
LLM_RETRY_MAX_BACKOFF=30.0        # seconds; exponential backoff ceiling

# --- n8n automation ---
N8N_BASE_URL=                # e.g. https://n8n.example.com

# --- Workflow execution + schedule workers ---
# Queue phases (retries / queued drain / timeouts) run every
# EXECUTION_POLL_INTERVAL_SECONDS; schedule dispatch runs at its own cadence
# and never delays the queue. All state lives in Postgres (restart-safe).
EXECUTION_POLL_INTERVAL_SECONDS=5
EXECUTION_BATCH_SIZE=10
EXECUTION_TIMEOUT_SECONDS=300
# Fair-drain: max orgs visited per poll (oldest-first); per-session statement
# timeout so a runaway sweep query never pins a DB connection.
EXECUTION_ORGS_PER_SWEEP=20
EXECUTION_STATEMENT_TIMEOUT_SECONDS=30
# Per-org cap on QUEUED+RETRYING executions; queue() refuses with 409 when
# reached (EXECUTION_MANAGE bypasses).
EXECUTION_MAX_PENDING_PER_ORG=500
# Retention sweep (default on): deletes execution_events older than 90 days and
# prunes dead worker heartbeat rows, in chunks, every retention interval.
EXECUTION_RETENTION_ENABLED=true
EXECUTION_EVENT_RETENTION_DAYS=90
EXECUTION_RETENTION_BATCH=1000
EXECUTION_RETENTION_INTERVAL_SECONDS=3600
SCHEDULE_DISPATCHER_ENABLED=true
SCHEDULE_POLL_INTERVAL_SECONDS=15
SCHEDULE_BATCH_LIMIT=100

# --- Credentials encryption ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
CREDENTIALS_ENC_KEY=
# Retiring master key during rotation (dual-read until the rekey worker is
# caught up). Its version label is CREDENTIAL_KEY_VERSION - 1.
CREDENTIALS_ENC_KEY_PREVIOUS=
# Version label of CREDENTIALS_ENC_KEY (positive integer; bump on rotation).
CREDENTIAL_KEY_VERSION=1
# Rekey worker: re-encrypt stale credentials with the current key.
CREDENTIAL_REKEY_ENABLED=false
CREDENTIAL_REKEY_BATCH=100
CREDENTIAL_REKEY_INTERVAL_SECONDS=3600

# --- Builtin (in-process) execution engine ---
# Limits bound the CPU/work bound a single builtin execution may do; raising
# them increases the resource ceiling of the worker that runs executions.
BUILTIN_MAX_STEPS=50
BUILTIN_MAX_CONDITION_DEPTH=3
BUILTIN_MAX_TEMPLATE_LENGTH=4000
BUILTIN_MAX_RESULT_SIZE_BYTES=524288

# --- Workflow event fan-out guards ---
# Max executions one published event may queue (runaway event_types are
# truncated); max serialized payload copied into every queued execution.
EVENT_FANOUT_MAX_TRIGGERS=100
EVENT_MAX_PAYLOAD_BYTES=262144

# --- Phase 5D AI Intelligence Layer (foundation) ---
# Feature flags gate each Phase 5D subsystem. Keep OFF until the subsystem
# ships and passes its quality gate; consumers treat an OFF flag as "feature
# unavailable" (fail closed).
AGENT_RUNTIME_ENABLED=false
AI_MEMORY_ENABLED=false
COMMUNICATION_LAYER_ENABLED=false
GROWTH_AGENT_ENABLED=false
# Data-lifecycle bounds used once each subsystem ships.
MEMORY_WORKING_TTL_DAYS=30      # working-memory TTL (days)
# Working-memory TTL cleanup worker (M4): deletes ONLY expired working memories
# in bounded, idempotent, org-scoped batches. Long-term memory is never pruned.
MEMORY_CLEANUP_ENABLED=true
MEMORY_CLEANUP_INTERVAL_SECONDS=3600  # seconds between TTL cleanup sweeps
MEMORY_CLEANUP_BATCH_SIZE=500         # max expired working memories deleted per tick
MEMORY_CONTEXT_MAX_CHARS=2500         # max chars of memory context injected into AI prompts
MEMORY_RETRIEVAL_LIMIT=10             # max memories/knowledge returned per retrieval
NOTIFICATION_RETENTION_DAYS=90  # in-app notification pruning horizon (days)
APPROVAL_EXPIRY_HOURS=24        # approval requests auto-expire (deny) after this
GROWTH_METRICS_RETENTION_DAYS=1095  # growth metrics horizon (36 months)
AGENT_RUN_RETENTION_DAYS=90     # agent run records horizon (configurable)
# M5 agent runtime worker: polls the queued agent-run buckets on Postgres.
AGENT_RUN_POLL_INTERVAL_SECONDS=5   # seconds between queue sweeps
AGENT_RUN_BATCH_SIZE=10             # max queued runs drained per sweep
AGENT_RUN_ORGS_PER_SWEEP=20         # max candidate orgs visited per sweep
AGENT_RUN_TIMEOUT_SECONDS=300       # stale RUNNING runs are re-converged as failed
