# AgencyOS backend — environment template
# Copy to .env (inside backend/) and fill in real values.
# Root-level .env (docker-compose) and this file are separate; when running
# uvicorn from backend/, app/core/config.py loads this file.

# --- App ---
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# --- Security ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ISSUER=agencyos
JWT_AUDIENCE=agencyos-api
# Shared secret for inbound webhooks (n8n / contact forms); required in prod.
WEBHOOK_SECRET=

# --- Database ---
# Local dev database (must match docker-compose postgres service)
DATABASE_URL=postgresql+asyncpg://agencyos:change-me@localhost:5432/agencyos
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# --- Supabase (managed PostgreSQL) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Redis (optional; shared rate limiting / cache across instances) ---
REDIS_URL=

# --- HTTP hardening ---
# Comma-separated origins allowed to call this API
CORS_ORIGINS=http://localhost:3000
# Comma-separated allowed Host headers
TRUSTED_HOSTS=localhost,127.0.0.1
SECURITY_HEADERS=true
ENABLE_CSP=false

# --- Logging ---
LOG_LEVEL=INFO
# Set true to also write logs to the rotating file under storage/logs/
LOG_TO_FILE=false
LOG_FILE_PATH=../storage/logs/backend.log

# --- Rate limiting (slowapi; Redis required for multi-instance) ---
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_STRICT=20/minute
# AI endpoints trigger LLM/n8n work — keep tighter than the default.
RATE_LIMIT_AI=60/minute

# --- CSV import worker ---
IMPORT_WORKER_ENABLED=true
IMPORT_CHUNK_SIZE=200
UPLOAD_DIR=../storage/uploads

# --- Observability (OpenTelemetry; enable in staging/production) ---
OTEL_ENABLED=false
OTEL_SERVICE_NAME=agencyos-api
OTEL_ENDPOINT=

# --- LLM provider layer (app/llm) ---
# Select the provider and default model used by LLMService. Secrets come from
# below; never commit real keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=openai          # openai | anthropic | gemini | openai-compatible | ollama | deepseek
LLM_DEFAULT_MODEL=gpt-4o-mini
LLM_BASE_URL=                # override for openai-compatible / ollama / deepseek
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=4096
LLM_DEFAULT_TEMPERATURE=0.7
LLM_MAX_RETRIES=3                 # transient provider failures (rate limit / 5xx)
LLM_RETRY_MIN_BACKOFF=1.0         # seconds; exponential backoff floor
LLM_RETRY_MAX_BACKOFF=30.0        # seconds; exponential backoff ceiling

# --- n8n automation ---
N8N_BASE_URL=                # e.g. https://n8n.example.com
